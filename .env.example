# horsebuy · .env.example
# 复制成 .env, 填真实值, 不能进 git

# ============ Server ============
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ============ Database ============
# Postgres 本地: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=horsebuy postgres:17
DATABASE_URL=postgresql://postgres:horsebuy@localhost:5432/horsebuy?schema=public

# ============ LLM ============
# W3 Agent 编排层需要
ANTHROPIC_API_KEY=sk-ant-xxx
# 备用 LLM (可选)
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# ============ 1688 Provider ============
# W5 之后填 (W1-W4 用 stub mock)
# 主公 W1 Day 6 (07/12) 调研 4 家后决定用哪家
ONE688_PROVIDER=stub
ONE688_APP_KEY=
ONE688_APP_SECRET=

# ============ Shopee (W7+ 才需要) ============
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_SANDBOX=true

# ============ Telegram Bot (W2 商家 Bot POC) ============
TELEGRAM_BOT_TOKEN=
# 主公自己 chat_id (从 @userinfobot 拿)
TELEGRAM_ADMIN_CHAT_ID=

# ============ WebSocket ============
WS_HEARTBEAT_MS=30000

# ============ 成本上限 (防跑飞) ============
MAX_COST_PER_TASK_CNY=10
MAX_SKU_PER_BATCH=100
